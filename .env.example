# =====================================================================
#  .env — secrets and per-install values.  Copy to .env and fill in.
#  NEVER commit .env to git (it is in .gitignore).
# =====================================================================

# --- Telegram API (from https://my.telegram.org → API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Phone number of the SEPARATE Telegram account that reads source channels
# (used only by login.py; leave empty to be asked interactively). Format: +91XXXXXXXXXX
PHONE=

# --- Bot (from @BotFather). The bot posts to your channel and talks to you.
BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGG

# Your numeric Telegram user id(s), comma separated. Only these can use the
# admin commands/buttons. Get yours from @userinfobot.
ADMIN_IDS=111111111

# Channel where deals are posted: @username, or -100… id for private channels.
# The bot must be an admin there with "Post messages" and "Edit messages".
TARGET_CHANNEL=@mychannel

# --- Affiliate
# Your Amazon Associates tracking id (ends with -21 for amazon.in)
AMAZON_TAG=yourtag-21

# Network for non-Amazon stores: none | earnkaro | cuelinks
# Keep "none" while only Amazon is enabled (config.yaml → enabled_stores).
AFFILIATE_NETWORK=none

# --- EarnKaro (only if AFFILIATE_NETWORK=earnkaro)
# TODO: copy these from your EarnKaro API documentation — nothing is assumed.
EARNKARO_API_URL=
EARNKARO_API_KEY=
EARNKARO_METHOD=POST
EARNKARO_AUTH_HEADER=Authorization
# {key} is replaced by EARNKARO_API_KEY
EARNKARO_AUTH_VALUE=Bearer {key}
# JSON field / query param name that carries the product URL
EARNKARO_REQUEST_FIELD=
# Optional extra constant fields as JSON, e.g. {"option":"value"}
EARNKARO_EXTRA_BODY=
# Dot path to the converted link in the JSON response, e.g. data.link
EARNKARO_RESPONSE_PATH=
EARNKARO_OUTPUT_DOMAINS=ekaro.in

# --- Cuelinks (only if AFFILIATE_NETWORK=cuelinks)
# TODO: copy these from your Cuelinks API documentation — nothing is assumed.
CUELINKS_API_URL=
CUELINKS_API_KEY=
CUELINKS_METHOD=GET
CUELINKS_AUTH_HEADER=Authorization
CUELINKS_AUTH_VALUE=
CUELINKS_REQUEST_FIELD=
CUELINKS_EXTRA_BODY=
CUELINKS_RESPONSE_PATH=
CUELINKS_OUTPUT_DOMAINS=linksredirect.com

# --- Runtime
# Folder for the database, session files, logs and temporary media
DATA_DIR=data
# Session file names (inside DATA_DIR)
USER_SESSION=user
BOT_SESSION=bot
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
# Time zone for quiet hours, "posts today" and the daily summary
TZ_NAME=Asia/Kolkata
